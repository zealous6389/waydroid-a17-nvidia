# Maintainer: zealous6389 <358092365+zealous6389@users.noreply.github.com>
# Based on cagedbird043's waydroid-a17-nvidia-bin package.
# GitHub fork release; no AUR publication or account is required.
#
# Native RM/NVK/nvrm and the matching vendor image are prebuilt. Packaging
# applies host patches and installs Python/data files; it never compiles
# Mesa, Rust, Android, or the installed NVIDIA kernel driver.
# The Android 17 system image is supplied separately by WayDroid-ATV.

pkgname=waydroid-a17-nvidia-bin
pkgver=20261117.1
pkgrel=1
_tag=a17-20261117-1
_wn_sha=29ffa3a237b0d79a751748bd9bb82c50dd577808
_wn_tag=v0.2.0-rc10
_waydroid_sha=a33a5c0b31d89d6ce687381104b30aff4dd2d330
pkgdesc="Waydroid Android 17 with NVIDIA open 620.70.06 support, NVK, ANGLE, NVDEC and NVENC"
arch=('x86_64')
url="https://github.com/zealous6389/waydroid-a17-nvidia"
license=('GPL-3.0-or-later' 'Apache-2.0' 'MIT')
depends=(
  'lxc' 'python' 'python-gbinder>=1.3.0' 'python-gobject' 'nftables' 'dnsmasq'
  'gtk3' 'python-dbus' 'pulse-native-provider'
  'binutils' 'e2fsprogs' 'erofs-utils' 'util-linux'
  'libepoxy' 'libdrm' 'mesa' 'libx11' 'expat' 'vulkan-icd-loader'
)
makedepends=('zstd' 'git')
optdepends=(
  'nvidia-open: NVIDIA open kernel module (the appropriate kernel-specific package also works)'
  'kernelsu-dkms: optional container root; see kernelsu/README.md'
)
provides=('waydroid')
conflicts=('waydroid' 'waydroid-nvidia-bin')
options=('!strip' '!debug')
install=waydroid-a17-nvidia.install
_wn_rel=https://github.com/Shiro836/waydroid-nvidia/releases/download/$_wn_tag
_rel=$url/releases/download/$_tag
source=(
  "waydroid-nvidia-$_wn_sha.tar.gz::https://github.com/Shiro836/waydroid-nvidia/archive/$_wn_sha.tar.gz"
  "waydroid-a17-nvidia-sources-$_tag.tar.zst::$_rel/waydroid-a17-nvidia-sources.tar.zst"
  "waydroid-$_waydroid_sha.tar.gz::https://github.com/waydroid/waydroid/archive/$_waydroid_sha.tar.gz"
  "$_wn_rel/waydroid-nvidia-host-x86_64-$_wn_tag.tar.zst"
  "$_wn_rel/waydroid-nvidia-guest-android-x86_64-$_wn_tag.tar.zst"
  "$_wn_rel/waydroid-nvidia-guest-prebuilts-$_wn_tag.tar.zst"
  "waydroid-a17-nvidia-native-x86_64-$_tag.tar.zst::$_rel/waydroid-a17-nvidia-native-x86_64.tar.zst"
  "$_rel/waydroid-nvidia-vendor-x86_64-$_tag.zip"
  "$_rel/waydroid-nvidia-vendor-ota-$_tag.json"
)
noextract=(
  "waydroid-nvidia-host-x86_64-$_wn_tag.tar.zst"
  "waydroid-nvidia-guest-android-x86_64-$_wn_tag.tar.zst"
  "waydroid-nvidia-guest-prebuilts-$_wn_tag.tar.zst"
  "waydroid-a17-nvidia-native-x86_64-$_tag.tar.zst"
  "waydroid-nvidia-vendor-x86_64-$_tag.zip"
)
sha256sums=('4dc67241bf35189d4490306611f7f52e49117d04511a60999e96328f010dd84f'
