     #[test]
+    fn nvidia_620_allocation_growth_preserves_615_and_zeroes_new_bytes() {
+        const GROUP: &str = "NV_CHANNEL_GROUP_ALLOCATION_PARAMETERS";
+        const SHARE: &str = "NV_CTXSHARE_ALLOCATION_PARAMETERS";
+        let latest = Compat::for_version("620.70.06").unwrap();
+        latest.require_client_abi().unwrap();
+        for (version, group_size, flags_offset, share_size) in [
+            ("615.71.09", 28, 24, 12),
+            ("615.78.08", 28, 24, 12),
+            ("620.70.06", 32, 28, 16),
+        ] {
+            let c = Compat::for_version(version).unwrap();
+            assert_eq!(c.layout_size(GROUP).unwrap(), group_size, "{version}");
+            assert_eq!(c.layout(GROUP).unwrap().field("internalFlags").unwrap().offset,
+                       flags_offset, "{version}");
+            assert_eq!(c.layout_size(SHARE).unwrap(), share_size, "{version}");
+            assert_eq!(c.allocation_layout(0xa06c, 28).unwrap(), Some(GROUP));
+            assert_eq!(c.allocation_layout(0x9067, 12).unwrap(), Some(SHARE));
+            let mut group = abi::ChannelGroup {
+                error: 0x11223344,
+                ecc_error: 0x22334455,
+                vaspace: 0x33445566,
+                engine: 0x44556677,
+                vgpu: 1,
+                padding: [0xff; 3],
+                reserved: 0x55667788,
+                flags: 0x66778899,
+            };
+            let mut wire = c.pack(GROUP, &group).unwrap();
+            let mut expected = vec![0; group_size];
+            for (offset, value) in [(0, group.error), (4, group.ecc_error),
+                (8, group.vaspace), (12, group.engine), (20, group.reserved),
+                (flags_offset, group.flags)] {
+                expected[offset..offset + 4].copy_from_slice(&value.to_ne_bytes());
+            }
+            expected[16] = 1;
+            assert_eq!(wire.bytes, expected, "{version}: padding/reserved2 must be zero");
+            wire.bytes[flags_offset..flags_offset + 4].copy_from_slice(&0x12345678u32.to_ne_bytes());
+            wire.unpack(&mut group).unwrap();
+            assert_eq!(group.flags, 0x12345678, "{version}");
+            let mut share = abi::ContextShare {
+                vaspace: 0x778899aa, flags: 2, subcontext: 3,
+            };
+            let mut wire = c.pack(SHARE, &share).unwrap();
+            let mut expected = vec![0; share_size];
+            for (offset, value) in [(0, share.vaspace), (4, share.flags), (8, share.subcontext)] {
+                expected[offset..offset + 4].copy_from_slice(&value.to_ne_bytes());
+            }
+            assert_eq!(wire.bytes, expected, "{version}: new reserved handle must be zero");
+            wire.bytes[8..12].copy_from_slice(&5u32.to_ne_bytes());
+            wire.unpack(&mut share).unwrap();
+            assert_eq!(share.subcontext, 5, "{version}");
+        }
+        assert_eq!(data::CANONICAL.layout(GROUP).unwrap().size, 28);
+        assert_eq!(data::CANONICAL.layout(SHARE).unwrap().size, 12);
+        assert_eq!(latest.profile.constants, data::CANONICAL.constants);
+        for &(name, old) in data::CANONICAL.layouts {
+            if name != GROUP && name != SHARE {
+                assert_eq!(latest.layout(name).unwrap(), old, "{name}");
+            }
+        }
+    }
